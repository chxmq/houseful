# Address of the platform key that signs World ID attestations.
VERIFIER_ADDRESS=
# Alternative to VERIFIER_ADDRESS: the address is derived from this key. Never commit a real key.
VERIFIER_PRIVATE_KEY=

# Key that pays for deployment on World Chain Sepolia.
DEPLOYER_PRIVATE_KEY=
WORLDCHAIN_SEPOLIA_RPC_URL=https://worldchain-sepolia.g.alchemy.com/public

# Optional
LOCAL_RPC_URL=http://127.0.0.1:8545
REPORT_GAS=false
