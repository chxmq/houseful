{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit && tsc --noEmit -p e2e/tsconfig.json",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:phone": "playwright test --project=phone",
    "e2e:stack": "tsx e2e/stack/cli.ts",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/reset.ts && drizzle-kit push --force && tsx scripts/seed.ts",
    "db:check": "tsx --conditions=react-server scripts/check-catalog.ts"
  },
  "dependencies": {
    "@houseful/contracts": "workspace:*",
    "@houseful/pass": "workspace:*",
    "@libsql/client": "^0.18.0",
    "@tanstack/react-query": "^5.106.1",
    "@worldcoin/idkit": "^4.6.0",
    "drizzle-orm": "^0.45.4",
    "jsqr": "^1.4.0",
    "motion": "^14.9.1",
    "next": "16.4.5",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "viem": "^2.57.16",
    "wagmi": "^3.7.11",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@11.28.9"
}
