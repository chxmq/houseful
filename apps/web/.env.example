# Catalog database. A local file by default; use a Turso libsql URL and token in production.
DATABASE_URL=file:./data/houseful.db
DATABASE_AUTH_TOKEN=

# Public site URL (Open Graph, absolute links). Set on Vercel.
# NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# Chain. 31337 is local Hardhat. 1301 is Unichain Sepolia (v2). 4801 is World Chain Sepolia.
NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_HOUSEFUL_ADDRESS=
NEXT_PUBLIC_USDT_ADDRESS=
# Opt-in ETH→USDT swap at checkout. Leave false for a single "pay face value in USDT" path.
NEXT_PUBLIC_PAY_WITH_ETH=false
CHAIN_ID=31337
RPC_URL=http://127.0.0.1:8545
USDT_ADDRESS=

# World ID, from developer.world.org. Use staging with the simulator while developing.
WORLD_APP_ID=app_
WORLD_RP_ID=rp_
WORLD_RP_SIGNING_KEY=
WORLD_ENVIRONMENT=staging

# Signs the EIP-712 attestation the contract checks after a World ID proof. Must match the
# contract's verifier address. The value below is Hardhat account #1, for local use only.
ATTESTER_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d

# Funds each phone's built-in wallet with test ETH. Hardhat account #0 locally.
FAUCET_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
FAUCET_DRIP_ETH=0.02

# ed25519 secret (32 bytes hex) that signs offline door credentials.
DOOR_ISSUER_SECRET_KEY=
